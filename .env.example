# Development environment variables
# Copy to .env and fill in your values

# Service settings
APP_NAME="Recipe Import Engine"
DEBUG=true

# API authentication (leave empty for open access in dev)
API_KEY=

# Default LLM provider settings
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=

# Provider API keys (for managed mode - when clients don't provide BYOK)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
