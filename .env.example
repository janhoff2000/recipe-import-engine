# Development environment variables
# Copy to .env and fill in your values

# Service settings
APP_NAME="Recipe Import Engine"
DEBUG=true
LOG_LEVEL=INFO

# API authentication (leave empty for open access in dev)
API_KEY=

# Default LLM model (auto-detects provider from model name)
# Options: gpt-4.1-nano, gpt-5-nano, gpt-5-mini, gemini-2.5-flash-lite
DEFAULT_MODEL=gpt-4.1-nano

# Provider API keys
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Meta oEmbed API (for Instagram)
# Option 1: Provide full token directly
META_APP_TOKEN=
# Option 2: Provide app ID and secret (token will be constructed as {id}|{secret})
META_APP_ID=
META_APP_SECRET=

# CORS origins (comma-separated)
CORS_ORIGINS=["*"]

# Tracking database path
TRACKING_DB_PATH=data/tracking.db
